# Sovereign-AMM Frontend Environment Variables
# Copy this file to .env.local and fill in your values.

# WebSocket URL for real-time market data stream (10 Hz)
# Use wss:// for production, ws:// for local development
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Grid streamed on the dashboards (public demo grid)
NEXT_PUBLIC_GRID_ID=demo

# Auto-start a Guest Demo Session (unlocks PnL / LMP / PTDF / risk panels)
NEXT_PUBLIC_AUTO_DEMO=true

# REST API base URL for backend engine endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth 2.0 Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=588749850201-kokgobskc79ksrivs2r125p5s3ftudsh.apps.googleusercontent.com